# ── Dependencies ──────────────────────────────────────────────────────
node_modules/
**/node_modules/
.npm
.pnp.*

# ── Environment / secrets (NEVER commit real values) ──────────────────
# Only *.sample / *.example templates may be committed.
.env
.env.*
**/.env
**/.env.*
!**/.env.sample
!**/.env.example

# ── Build output ──────────────────────────────────────────────────────
dist/
**/dist/
build/
out/

# ── Uploaded / temp scratch files ─────────────────────────────────────
# Keep the folder (via .gitkeep) but ignore anything dropped into it.
server/public/temp/*
!server/public/temp/.gitkeep

# ── Kiro spec workspace (local-only, not part of the deployable app) ──
.kiro/

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.swp

# ── Test / coverage ───────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
.eslintcache
