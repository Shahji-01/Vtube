# VTube client environment template.
# Copy to .env for local dev, and set the same vars in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.

# Base URL of the backend API, INCLUDING the /api/v1 suffix.
# - Local dev:  http://localhost:8000/api/v1
# - Production: https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# (Optional) Socket.IO server origin (NO /api/v1 suffix). If omitted, the client
# derives it from VITE_API_URL's origin, falling back to the page origin.
# - Production: https://<your-render-service>.onrender.com
VITE_SOCKET_URL=
