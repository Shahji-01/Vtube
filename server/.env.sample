# VTube Production Environment Variables Template
# Copy this file to .env and fill in the values for deployment.

# ── General ────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── MongoDB ───────────────────────────────────────────────────────────
# Get your connection string from MongoDB Atlas
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URL=

# ── DNS (optional) ────────────────────────────────────────────────────
# Optional comma-separated list of DNS server IP addresses (IPv4 or IPv6).
# Used to work around local/ISP resolvers that refuse the MongoDB Atlas
# mongodb+srv SRV lookup (querySrv ECONNREFUSED / ESERVFAIL). Leave blank to
# use the system default resolver.
# Example: DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_SERVERS=

# ── Security ──────────────────────────────────────────────────────────
# Use 'openssl rand -hex 32' to generate secure secrets
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# ── CORS ──────────────────────────────────────────────────────────────
# In production, set this to your frontend URL (e.g., https://vtube.vercel.app)
# If serving frontend from the same backend server (Render), you can leave as is or set to "*"
# NOTE: the wildcard "*" is ignored in production (credentials require an exact origin).
COR_ORIGIN=

# Cookie SameSite policy for the auth cookies. Defaults to "strict" (best CSRF
# protection) for the same-site SPA + API deployment. Set to "none" ONLY for a
# genuinely cross-site frontend (requires HTTPS, i.e. NODE_ENV=production).
# Allowed values: strict | lax | none
COOKIE_SAMESITE=strict

# ── Cloudinary ────────────────────────────────────────────────────────
# Get these from your Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Logging ───────────────────────────────────────────────────────────
# Controls log verbosity in non-production environments (e.g. debug, info,
# warn, error). In production this value is ignored and the level is forced
# to info or higher to avoid leaking debug detail.
LOG_LEVEL=debug

# ── Rate-limit overrides (test/staging only) ──────────────────────────
# Override the per-window request limits for the global, auth, and upload
# limiters. Intended for test/staging tuning only. Leave blank to use the
# Phase 1 production defaults (global 200 / auth 10 / upload 20).
RATE_LIMIT_GLOBAL=
RATE_LIMIT_AUTH=
RATE_LIMIT_UPLOAD=

# ── Account lockout ───────────────────────────────────────────────────
# Per-account brute-force protection. After LOCKOUT_MAX_FAILURES failed
# logins within LOCKOUT_WINDOW_MS, the account is locked for
# LOCKOUT_DURATION_MS. Defaults: 5 failures, 15 min window, 15 min lock.
LOCKOUT_MAX_FAILURES=5
LOCKOUT_WINDOW_MS=900000
LOCKOUT_DURATION_MS=900000

# ── Email service ─────────────────────────────────────────────────────
# SMTP credentials for the transactional email integration. When any of
# these are blank the email service is disabled and the email-verification
# and password-reset flows become no-ops (no startup error).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_AUTH_USER=
EMAIL_AUTH_PASS=
EMAIL_FROM=

# ── Error monitoring ──────────────────────────────────────────────────
# Sentry DSN for error reporting. When blank or whitespace, Sentry is
# disabled and error reporting becomes a no-op.
SENTRY_DSN=

# ── Google OAuth ──────────────────────────────────────────────────────
# Credentials for Google sign-in. When both are blank, Google sign-in is
# disabled (no startup error).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
